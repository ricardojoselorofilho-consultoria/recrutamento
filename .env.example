# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública (anon / publishable). Usada só no login do recrutador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave secreta (service_role / secret). NUNCA expor no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Endereço público do sistema, sem barra no final (usado para montar os links)
NEXT_PUBLIC_SITE_URL=https://avaliacao.suaempresa.com.br

# Opcional: envio automático dos convites por e-mail (resend.com)
RESEND_API_KEY=
EMAIL_REMETENTE=RJL Consultoria <avaliacao@suaempresa.com.br>
